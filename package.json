{
  "name": "forever-planner",
  "version": "2.0.0",
  "description": "Forever Planner: a server-rendered wedding planning app (budget, guests, vendors, checklist, music, inspiration, collaborators).",
  "homepage": "https://github.com/Timowhit/Wedding#readme",
  "bugs": {
    "url": "https://github.com/Timowhit/Wedding/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Timowhit/Wedding.git"
  },
  "license": "ISC",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "nodemon",
    "start": "node --env-file-if-exists=.env server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "reminders": "node --env-file-if-exists=.env scripts/send-reminders.js",
    "cleanup-trials": "node --env-file-if-exists=.env scripts/cleanup-trials.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "build:themes": "node scripts/build-themes.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2"
  }
}
