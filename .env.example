# Required
DB_URL=postgresql://user:password@host:5432/forever_planner
SESSION_SECRET=

# Optional
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
ENABLE_SQL_LOGGING=false

# Optional TLS settings (see src/models/db.js)
# DB_CA=
# DB_SSL_INSECURE=true

# Optional: Google sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: music search (Spotify client-credentials app)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Optional: inspiration search
# UNSPLASH_ACCESS_KEY=

# Optional: invite emails (without SMTP_HOST, invite links are shown on the Settings page instead)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=noreply@example.com
