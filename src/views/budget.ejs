<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main-content">
    <%- include('partials/page-header', { heading: 'budget.heading', subtitle: 'budget.subtitle' }) %>
    <%- include('partials/flash') %>
    <%- include('partials/read-only-notice') %>

    <section class="card" aria-labelledby="summary-heading">
        <h2 class="visually-hidden" id="summary-heading"><%= t('budget.summary') %></h2>
        <dl class="budget-summary">
            <div class="budget-box"><dt><%= t('budget.total') %></dt><dd><%= summary.limit > 0 ? formatCurrency(summary.limit) : t('budget.notSet') %></dd></div>
            <div class="budget-box"><dt><%= t('budget.spent') %></dt><dd><%= formatCurrency(summary.spent) %></dd></div>
            <div class="budget-box <%= summary.remaining < 0 ? 'budget-box--over' : '' %>">
                <dt><%= t('budget.remaining') %></dt><dd><%= summary.limit > 0 ? formatCurrency(summary.remaining) : '—' %></dd>
            </div>
        </dl>
        <% if (summary.limit > 0) { %>
            <label class="progress-label" for="budget-progress"><%= t('budget.used', { pct: summary.pct }) %></label>
            <progress id="budget-progress" class="progress <%= summary.over ? 'progress--over' : '' %>" max="100" value="<%= summary.pct %>"><%= summary.pct %>%</progress>
            <% if (summary.over) { %><p class="notice notice--error"><%= t('budget.overBudget') %></p><% } %>
        <% } %>

        <% if (canEdit) { %>
            <details class="disclosure" <%= summary.limit === 0 || limitForm.errors.length > 0 ? 'open' : '' %>>
                <summary><%= t(summary.limit > 0 ? 'budget.editLimit' : 'budget.setLimit') %></summary>
                <%- include('partials/form-errors', { errors: limitForm.errors, id: 'limit-errors' }) %>
                <form method="post" action="/budget/limit" class="inline-form inline-form--start">
                    <%- include('partials/csrf-field') %>
                    <label for="total"><%= t('field.total') %></label>
                    <input type="text" inputmode="decimal" id="total" name="total" required maxlength="16"
                           value="<%= limitForm.values.total %>" placeholder="25000"
                           <%- fieldState(limitForm.errors, 'total', 'limit-errors') %>>
                    <button type="submit" class="btn btn-secondary"><%= t('budget.saveLimit') %></button>
                </form>
            </details>
        <% } %>
    </section>

    <% if (categoryTotals.length > 0) { %>
        <section class="card" aria-labelledby="by-category-heading">
            <h2 class="card-title" id="by-category-heading"><%= t('budget.byCategory') %></h2>
            <ul class="category-totals">
                <% categoryTotals.forEach((row) => { %>
                    <% const share = summary.spent > 0 ? Math.round((row.total / summary.spent) * 100) : 0; %>
                    <li class="category-total">
                        <a href="/budget?category=<%= encodeURIComponent(row.category) %>" class="category-total__name"><%= t(`budgetCategory.${row.category}`) %></a>
                        <span class="category-total__amount"><%= formatCurrency(row.total) %></span>
                        <span class="category-total__share"><%= t('budget.share', { pct: share }) %></span>
                        <progress class="progress progress--thin" max="100" value="<%= share %>" aria-hidden="true"></progress>
                    </li>
                <% }); %>
            </ul>
        </section>
    <% } %>

    <% if (canEdit) { %>
        <%- include('partials/add-panel-start', { id: 'add-expense', labelKey: 'budget.addExpense', open: (summary.spent === 0 && summary.limit > 0) || expenseForm.errors.length > 0 }) %>
            <%- include('partials/form-errors', { errors: expenseForm.errors, id: 'expense-errors' }) %>
            <form method="post" action="/budget/expenses" class="form-grid">
                <%- include('partials/csrf-field') %>
                <%- include('partials/return-to') %>
                <div class="field field--wide">
                    <label for="name"><%= t('field.description') %></label>
                    <input type="text" id="name" name="name" required maxlength="200" value="<%= expenseForm.values.name %>"
                           placeholder="<%= t('budget.descriptionPlaceholder') %>" <%- fieldState(expenseForm.errors, 'name', 'expense-errors') %>>
                </div>
                <div class="field">
                    <label for="category"><%= t('field.category') %></label>
                    <select id="category" name="category" <%- fieldState(expenseForm.errors, 'category', 'expense-errors') %>>
                        <%- include('partials/options', { options: categories, selected: expenseForm.values.category, prefix: 'budgetCategory' }) %>
                    </select>
                </div>
                <div class="field">
                    <label for="amount"><%= t('field.amount') %></label>
                    <input type="text" inputmode="decimal" id="amount" name="amount" required maxlength="16"
                           value="<%= expenseForm.values.amount %>" placeholder="0.00" <%- fieldState(expenseForm.errors, 'amount', 'expense-errors') %>>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><%= t('budget.addExpenseSubmit') %></button>
                </div>
            </form>
        <%- include('partials/add-panel-end') %>
    <% } %>

    <section aria-labelledby="expenses-heading">
        <h2 class="section-heading" id="expenses-heading"><%= t('budget.expenses') %></h2>
        <% if (activeCategory) { %>
            <p class="filter-note"><%= t('budget.showingCategory', { category: t(`budgetCategory.${activeCategory}`) }) %> <a href="/budget"><%= t('filter.showAll') %></a></p>
        <% } %>

        <% if (expenses.length === 0) { %>
            <p class="empty-state"><span aria-hidden="true">💸</span> <%= t(activeCategory ? 'filter.noMatches' : 'budget.empty') %></p>
        <% } else { %>
            <ul class="item-list">
                <% expenses.forEach((expense) => { %>
                    <li class="item-card">
                        <div class="item-info">
                            <p class="item-name"><%= expense.name %></p>
                            <p class="item-meta"><span class="tag"><%= t(`budgetCategory.${expense.category}`) %></span></p>
                        </div>
                        <div class="item-side"><p class="item-amount"><%= formatCurrency(expense.amount) %></p></div>
                        <% if (canEdit) { %>
                            <%- include('partials/row-actions', { deleteAction: `/budget/expenses/${expense.id}/delete`, name: expense.name, confirm: t('confirm.deleteExpense', { name: expense.name }) }) %>
                        <% } %>
                    </li>
                <% }); %>
            </ul>
        <% } %>
    </section>
</main>

<%- include('partials/footer') %>
