<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main-content">
    <%- include('partials/page-header', { heading: 'budget.heading', subtitle: 'budget.subtitle' }) %>
    <%- include('partials/flash') %>
    <%- include('partials/read-only-notice') %>

    <section class="card" aria-labelledby="summary-heading">
        <h2 class="visually-hidden" id="summary-heading"><%= t('budget.summary') %></h2>
        <dl class="budget-summary">
            <div class="budget-box"><dt><%= t('budget.total') %></dt><dd><%= summary.limit > 0 ? formatCurrency(summary.limit) : t('budget.notSet') %></dd></div>
            <div class="budget-box"><dt><%= t('budget.committed') %></dt><dd><%= formatCurrency(summary.committed) %></dd></div>
            <div class="budget-box"><dt><%= t('budget.paid') %></dt><dd><%= formatCurrency(summary.paid) %></dd></div>
            <div class="budget-box"><dt><%= t('budget.owed') %></dt><dd><%= formatCurrency(summary.owed) %></dd></div>
            <div class="budget-box <%= summary.remaining < 0 ? 'budget-box--over' : '' %>">
                <dt><%= t('budget.remaining') %></dt><dd><%= summary.limit > 0 ? formatCurrency(summary.remaining) : '—' %></dd>
            </div>
        </dl>
        <% if (summary.limit > 0) { %>
            <label class="progress-label" for="budget-progress"><%= t('budget.used', { pct: summary.pct, paid: summary.paidPct }) %></label>
            <progress id="budget-progress" class="progress <%= summary.over ? 'progress--over' : '' %>" max="100" value="<%= summary.pct %>"><%= summary.pct %>%</progress>
            <% if (summary.over) { %><p class="notice notice--error"><%= t('budget.overBudget') %></p><% } %>
        <% } %>
        <% if (duplicateHint) { %><p class="notice"><%= t('budget.duplicateHint') %> <a href="#expenses-heading"><%= t('budget.reviewExpenses') %></a></p><% } %>

        <% if (canEdit) { %>
            <details class="disclosure" <%= summary.limit === 0 || limitForm.errors.length > 0 ? 'open' : '' %>>
                <summary><%= t(summary.limit > 0 ? 'budget.editLimit' : 'budget.setLimit') %></summary>
                <%- include('partials/form-errors', { errors: limitForm.errors, id: 'limit-errors' }) %>
                <form method="post" action="/budget/limit" class="inline-form inline-form--start">
                    <%- include('partials/csrf-field') %>
                    <label for="total"><%= t('field.total') %></label>
                    <input type="text" inputmode="decimal" id="total" name="total" required maxlength="16"
                           value="<%= limitForm.values.total %>" placeholder="25000"
                           <%- fieldState(limitForm.errors, 'total', 'limit-errors') %>>
                    <button type="submit" class="btn btn-secondary"><%= t('budget.saveLimit') %></button>
                </form>
            </details>
        <% } %>
    </section>

    <% if (categoryRows.length > 0 || canEdit) { %>
        <section class="card" aria-labelledby="by-category-heading">
            <h2 class="card-title" id="by-category-heading"><%= t('budget.byCategory') %></h2>
            <% if (categoryRows.length > 0) { %>
                <ul class="category-totals">
                    <% categoryRows.forEach((row) => { %>
                        <% const share = summary.committed > 0 ? Math.round((row.total / summary.committed) * 100) : 0; %>
                        <% const planShare = row.planned > 0 ? Math.min(Math.round((row.total / row.planned) * 100), 100) : share; %>
                        <li class="category-total<%= row.planned > 0 && row.total > row.planned ? ' category-total--over' : '' %>">
                            <a href="/budget?category=<%= encodeURIComponent(row.value) %>" class="category-total__name"><%= row.label %></a>
                            <span class="category-total__amount"><%= formatCurrency(row.total) %><% if (row.planned > 0) { %> <span class="category-total__plan"><%= t('budget.ofPlanned', { planned: formatCurrency(row.planned) }) %></span><% } %></span>
                            <span class="category-total__share"><%= t('budget.share', { pct: share }) %></span>
                            <progress class="progress progress--thin" max="100" value="<%= planShare %>" aria-hidden="true"></progress>
                        </li>
                    <% }); %>
                </ul>
            <% } else { %>
                <p class="hint"><%= t('budget.byCategoryEmpty') %></p>
            <% } %>

            <% if (canEdit) { %>
                <details class="disclosure" <%= categoryForm.errors.length > 0 || planForm ? 'open' : '' %>>
                    <summary><%= t('budget.manageCategories') %></summary>
                    <% if (planForm) { %><%- include('partials/form-errors', { errors: planForm.errors, id: 'plan-errors' }) %><% } %>
                    <ul class="category-manage">
                        <% categories.forEach((category) => { const failed = planForm && planForm.id === category.id; %>
                            <li class="category-manage__row">
                                <form method="post" action="/budget/categories/<%= category.id %>/plan" class="inline-form category-manage__plan">
                                    <%- include('partials/csrf-field') %>
                                    <%- include('partials/return-to') %>
                                    <label for="plan-<%= category.id %>" class="category-manage__name"><%= category.label %><span class="visually-hidden"> · <%= t('field.planned') %></span></label>
                                    <input type="text" inputmode="decimal" id="plan-<%= category.id %>" name="planned" maxlength="16"
                                           value="<%= failed ? planForm.values.planned : (category.planned ?? '') %>" placeholder="<%= t('budget.plannedPlaceholder') %>"
                                           <%- failed ? fieldState(planForm.errors, 'planned', 'plan-errors') : '' %>>
                                    <button type="submit" class="btn btn-secondary btn-small" aria-label="<%= t('budget.savePlannedFor', { name: category.label }) %>"><%= t('budget.savePlanned') %></button>
                                </form>
                                <% if (category.deletable) { %>
                                    <form method="post" action="/budget/categories/<%= category.id %>/delete" class="inline-form" data-confirm="<%= t('confirm.deleteCategory', { name: category.label, other: categoryLabel('Other') }) %>">
                                        <%- include('partials/csrf-field') %>
                                        <%- include('partials/return-to') %>
                                        <button type="submit" class="link-action link-action--danger" aria-label="<%= t('action.deleteNamed', { name: category.label }) %>"><%= t('action.delete') %></button>
                                    </form>
                                <% } %>
                            </li>
                        <% }); %>
                    </ul>
                    <p class="hint"><%= t('budget.categoriesHint') %></p>

                    <h3 class="subheading"><%= t('budget.addCategory') %></h3>
                    <%- include('partials/form-errors', { errors: categoryForm.errors, id: 'category-errors' }) %>
                    <form method="post" action="/budget/categories" class="form-grid">
                        <%- include('partials/csrf-field') %>
                        <%- include('partials/return-to') %>
                        <div class="field">
                            <label for="category-name"><%= t('field.name') %></label>
                            <input type="text" id="category-name" name="name" required maxlength="<%= categoryNameMax %>" value="<%= categoryForm.values.name %>"
                                   placeholder="<%= t('budget.categoryPlaceholder') %>" <%- fieldState(categoryForm.errors, 'name', 'category-errors') %>>
                        </div>
                        <div class="field">
                            <label for="category-planned"><%= t('field.planned') %> <span class="optional"><%= t('form.optional') %></span></label>
                            <input type="text" inputmode="decimal" id="category-planned" name="planned" maxlength="16" value="<%= categoryForm.values.planned %>"
                                   placeholder="0.00" <%- fieldState(categoryForm.errors, 'planned', 'category-errors') %>>
                        </div>
                        <div class="form-actions"><button type="submit" class="btn btn-secondary"><%= t('budget.addCategorySubmit') %></button></div>
                    </form>
                    <% if (missingSuggested) { %>
                        <form method="post" action="/budget/categories/suggested" class="inline-form">
                            <%- include('partials/csrf-field') %>
                            <%- include('partials/return-to') %>
                            <button type="submit" class="btn btn-ghost btn-small"><%= t('budget.addSuggested') %></button>
                        </form>
                    <% } %>
                </details>
            <% } %>
        </section>
    <% } %>

    <% if (canEdit) { %>
        <%- include('partials/add-panel-start', { id: 'add-expense', labelKey: 'budget.addExpense', open: (summary.expenses === 0 && contracts.length === 0 && summary.limit > 0) || expenseForm.errors.length > 0 }) %>
            <%- include('partials/form-errors', { errors: expenseForm.errors, id: 'expense-errors' }) %>
            <form method="post" action="/budget/expenses" class="form-grid">
                <%- include('partials/csrf-field') %>
                <%- include('partials/return-to') %>
                <div class="field field--wide">
                    <label for="name"><%= t('field.description') %></label>
                    <input type="text" id="name" name="name" required maxlength="200" value="<%= expenseForm.values.name %>"
                           placeholder="<%= t('budget.descriptionPlaceholder') %>" <%- fieldState(expenseForm.errors, 'name', 'expense-errors') %>>
                </div>
                <div class="field">
                    <label for="category"><%= t('field.category') %></label>
                    <select id="category" name="category" <%- fieldState(expenseForm.errors, 'category', 'expense-errors') %>>
                        <% categories.forEach((category) => { %>
                            <option value="<%= category.value %>" <%= category.value === expenseForm.values.category ? 'selected' : '' %>><%= category.label %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="field">
                    <label for="amount"><%= t('field.amount') %></label>
                    <input type="text" inputmode="decimal" id="amount" name="amount" required maxlength="16"
                           value="<%= expenseForm.values.amount %>" placeholder="0.00" <%- fieldState(expenseForm.errors, 'amount', 'expense-errors') %>>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><%= t('budget.addExpenseSubmit') %></button>
                </div>
            </form>
        <%- include('partials/add-panel-end') %>
    <% } %>

    <% if (contracts.length > 0) { %>
        <section aria-labelledby="contracts-heading">
            <h2 class="section-heading" id="contracts-heading"><%= t('budget.vendorContracts') %></h2>
            <ul class="item-list">
                <% contracts.forEach((row) => { %>
                    <li class="item-card">
                        <div class="item-info">
                            <p class="item-name"><a class="item-link" href="/vendors/<%= row.id %>"><%= row.name %></a> <span class="tag"><%= categoryLabel(row.budgetCategory) %></span></p>
                            <p class="item-meta money-line"><%= t('budget.contractPaid', { paid: formatCurrency(row.paid), owed: formatCurrency(row.owed) }) %></p>
                        </div>
                        <p class="item-amount"><%= formatCurrency(row.committed) %></p>
                    </li>
                <% }); %>
            </ul>
        </section>
    <% } %>
    <section aria-labelledby="expenses-heading">
        <h2 class="section-heading" id="expenses-heading"><%= t(contracts.length > 0 ? 'budget.otherExpenses' : 'budget.expenses') %></h2>
        <% if (activeCategory) { %>
            <p class="filter-note"><%= t('budget.showingCategory', { category: categoryLabel(activeCategory) }) %> <a href="/budget"><%= t('filter.showAll') %></a></p>
        <% } %>

        <% if (expenses.length === 0) { %>
            <p class="empty-state"><span aria-hidden="true">💸</span> <%= t(activeCategory ? 'filter.noMatches' : 'budget.empty') %></p>
        <% } else { %>
            <ul class="item-list">
                <% expenses.forEach((expense) => { %>
                    <li class="item-card">
                        <div class="item-info">
                            <p class="item-name"><%= expense.name %></p>
                            <p class="item-meta"><span class="tag"><%= categoryLabel(expense.category) %></span></p>
                        </div>
                        <div class="item-side"><p class="item-amount"><%= formatCurrency(expense.amount) %></p></div>
                        <% if (canEdit) { %>
                            <%- include('partials/row-actions', { deleteAction: `/budget/expenses/${expense.id}/delete`, name: expense.name, confirm: t('confirm.deleteExpense', { name: expense.name }) }) %>
                        <% } %>
                    </li>
                <% }); %>
            </ul>
        <% } %>
    </section>
</main>

<%- include('partials/footer') %>
