<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main-content" class="narrow">
    <%- include('partials/page-header', { heading: 'auth.loginHeading', subtitle: 'auth.loginSubtitle' }) %>
    <%- include('partials/flash') %>

    <section class="card" aria-labelledby="login-heading">
        <h2 class="card-title" id="login-heading"><%= t('auth.signIn') %></h2>
        <% if (googleEnabled) { %>
            <a class="btn btn-google btn-full" href="/auth/google"><%= t('auth.continueWithGoogle') %></a>
            <p class="divider"><span><%= t('auth.or') %></span></p>
        <% } %>

        <%- include('partials/form-errors', { errors }) %>
        <form method="post" action="/login" class="form-stack">
            <%- include('partials/csrf-field') %>
            <div class="field">
                <label for="email"><%= t('field.email') %></label>
                <input type="email" id="email" name="email" value="<%= values.email %>" required maxlength="255"
                       autocomplete="username" <%- fieldState(errors, 'email') %>>
            </div>
            <div class="field">
                <label for="password"><%= t('field.password') %></label>
                <input type="password" id="password" name="password" required maxlength="200"
                       autocomplete="current-password" <%- fieldState(errors, 'password') %>>
            </div>
            <button type="submit" class="btn btn-primary btn-full"><%= t('auth.signIn') %></button>
        </form>
        <p class="form-footnote"><%= t('auth.noAccount') %> <a href="/start"><%= t('auth.createAccount') %></a></p>
    </section>
</main>

<%- include('partials/footer') %>
