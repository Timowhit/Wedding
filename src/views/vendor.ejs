<%- include('partials/head') %>
<%- include('partials/header') %>

<% const hasContract = vendor.contract_total !== null || vendor.contract_signed_on || vendor.contract_url || vendor.contract_includes || vendor.contract_cancellation; %>
<% const website = vendor.website && /^https?:\/\//i.test(vendor.website) ? vendor.website : null; %>
<main id="main-content" class="narrow">
    <p class="back-link"><a href="/vendors"><span aria-hidden="true">←</span> <%= t('vendor.back') %></a></p>
    <header class="page-header page-header--left">
        <h1><%= vendor.name %></h1>
        <p class="item-meta">
            <span class="tag"><%= t(`vendorCategory.${vendor.category}`) %></span>
            <span class="tag"><%= t(`vendorStatus.${vendor.status}`) %></span>
        </p>
        <% if (vendor.phone || vendor.email || website) { %>
            <ul class="contact-list">
                <% if (vendor.phone) { %><li><a href="tel:<%= vendor.phone.replace(/[^\d+]/g, '') %>"><%= vendor.phone %></a></li><% } %>
                <% if (vendor.email) { %><li><a href="mailto:<%= vendor.email %>"><%= vendor.email %></a></li><% } %>
                <% if (website) { %><li><a href="<%= website %>" rel="noopener noreferrer" target="_blank"><%= t('vendors.visitWebsite') %><span class="visually-hidden"> (<%= t('action.opensNewTab') %>)</span></a></li><% } %>
            </ul>
        <% } %>
        <% if (canEdit) { %><a class="link-action" href="/vendors/<%= vendor.id %>/edit"><%= t('vendor.editVendor') %></a><% } %>
    </header>
    <%- include('partials/flash') %>
    <%- include('partials/read-only-notice') %>

    <section class="card" aria-labelledby="contract-heading">
        <h2 class="card-title" id="contract-heading"><%= t('contract.heading') %></h2>
        <% if (!hasContract) { %>
            <p class="empty-state"><%= t('contract.empty') %></p>
            <% if (canEdit) { %><a class="btn btn-secondary btn-small" href="/vendors/<%= vendor.id %>/contract"><%= t('contract.add') %></a><% } %>
        <% } else { %>
            <p class="contract-facts">
                <% if (vendor.contract_signed_on) { %><span><%= t('contract.signedOn', { date: formatDate(vendor.contract_signed_on) }) %></span><% } %>
                <% if (vendor.contract_total !== null) { %>
                    <span><%= t(money.quote !== null ? 'contract.quote' : 'contract.total', { amount: formatCurrency(vendor.contract_total) }) %></span>
                <% } %>
                <% if (vendor.contract_url) { %>
                    <span><a href="<%= vendor.contract_url %>" target="_blank" rel="noopener noreferrer"><%= t('contract.viewSigned') %><span class="visually-hidden"> (<%= t('action.opensNewTab') %>)</span></a></span>
                <% } %>
            </p>
            <% if (vendor.contract_includes) { %>
                <h3 class="subheading"><%= t('contract.includes') %></h3>
                <p class="preserve-lines"><%= vendor.contract_includes %></p>
            <% } %>
            <% if (vendor.contract_cancellation) { %>
                <h3 class="subheading"><%= t('contract.cancellation') %></h3>
                <p class="preserve-lines"><%= vendor.contract_cancellation %></p>
            <% } %>
            <% if (canEdit) { %><a class="link-action" href="/vendors/<%= vendor.id %>/contract"><%= t('contract.edit') %></a><% } %>
        <% } %>
    </section>

<% if (vendor.status === 'Booked' || vendor.rating) { %>
    <section class="card" aria-labelledby="rating-heading">
        <h2 class="card-title" id="rating-heading"><%= t('wrapup.ratingHeading') %></h2>
        <% if (vendor.rating) { %>
            <p class="stars"><span class="visually-hidden"><%= t('wrapup.rated', { rating: vendor.rating, max: ratingMax }) %></span><span aria-hidden="true"><%= '★'.repeat(vendor.rating) + '☆'.repeat(ratingMax - vendor.rating) %></span></p>
            <% if (vendor.review) { %><p class="preserve-lines"><%= vendor.review %></p><% } %>
        <% } else { %>
            <p class="hint"><%= t('wrapup.ratingHint') %></p>
        <% } %>
        <% if (canEdit) { %>
            <%- include('partials/form-errors', { errors: ratingForm.errors, id: 'rating-errors' }) %>
            <form method="post" action="/vendors/<%= vendor.id %>/rating" class="form-stack">
                <%- include('partials/csrf-field') %>
                <fieldset class="choice-group star-choice" <%- fieldState(ratingForm.errors, 'rating', 'rating-errors') %>>
                    <legend><%= t('field.rating') %></legend>
                    <% for (let n = 1; n <= ratingMax; n += 1) { %>
                        <label class="choice">
                            <input type="radio" name="rating" value="<%= n %>" <%= String(n) === ratingForm.values.rating ? 'checked' : '' %>>
                            <span aria-hidden="true"><%= '★'.repeat(n) %></span><span class="visually-hidden"><%= t(n === 1 ? 'wrapup.starsOne' : 'wrapup.stars', { count: n }) %></span>
                        </label>
                    <% } %>
                </fieldset>
                <div class="field">
                    <label for="review"><%= t('field.review') %> <span class="optional"><%= t('form.optional') %></span></label>
                    <textarea id="review" name="review" rows="3" maxlength="2000" <%- fieldState(ratingForm.errors, 'review', 'rating-errors') %>><%= ratingForm.values.review %></textarea>
                </div>
                <div class="form-actions"><button type="submit" class="btn btn-primary btn-small"><%= t('wrapup.saveRating') %></button></div>
            </form>
            <% if (vendor.rating) { %>
                <form method="post" action="/vendors/<%= vendor.id %>/rating/clear" class="inline-form" data-confirm="<%= t('wrapup.confirmClearRating', { name: vendor.name }) %>">
                    <%- include('partials/csrf-field') %>
                    <button type="submit" class="link-action link-action--danger"><%= t('wrapup.clearRating') %></button>
                </form>
            <% } %>
        <% } %>
    </section>
<% } %>

<section class="card" aria-labelledby="vendor-files-heading">
        <h2 class="card-title" id="vendor-files-heading"><%= t('files.vendorHeading') %></h2>
        <% if (vendorFiles.length === 0) { %>
            <p class="hint"><%= t('files.vendorEmpty') %></p>
        <% } else { %>
            <%- include('partials/file-list', { files: vendorFiles }) %>
        <% } %>
        <% if (canEdit) { %>
            <details class="disclosure" <%= uploadForm.errors.length > 0 ? 'open' : '' %>>
                <summary><%= t('files.add') %></summary>
                <%- include('partials/file-upload-form', { form: uploadForm, vendor, kinds: fileKinds, fileMaxMb, noteMax }) %>
            </details>
        <% } %>
    </section>

    <section class="card" aria-labelledby="payments-heading">
        <div class="card-header">
            <h2 class="card-title" id="payments-heading"><%= t('payments.heading') %></h2>
            <% if (money.counts && (money.committed > 0 || payments.length > 0)) { %>
                <p class="payments-summary"><%= t('payments.paidSoFar', { amount: formatCurrency(money.paid) }) %> · <strong><%= t('vendor.stillOwed', { amount: formatCurrency(money.owed) }) %></strong></p>
            <% } %>
        </div>
        <% if (!money.counts && payments.length > 0) { %>
            <p class="hint"><%= t(vendor.status === 'Declined' ? 'payments.declinedNote' : 'payments.notBookedNote') %></p>
        <% } %>
        <% if (payments.length === 0) { %>
            <p class="empty-state"><%= t('payments.empty') %></p>
        <% } else { %>
            <ul class="payment-list">
                <% payments.forEach((p) => { %>
                    <% const name = p.label || t('payments.payment'); %>
                    <% const overdue = money.counts && !p.paid_on && p.due_date && toIsoDate(p.due_date) < today; %>
                    <li class="payment <%= p.paid_on ? 'payment--paid' : '' %>">
                        <div class="payment__main">
                            <p class="payment__name"><% if (p.paid_on) { %><span aria-hidden="true">✓ </span><% } %><%= name %></p>
                            <p class="payment__amount"><%= formatCurrency(p.amount) %></p>
                            <p class="payment__when <%= overdue ? 'text-danger' : '' %>">
                                <% if (p.paid_on) { %><%= t('payments.paidOn', { date: formatDate(p.paid_on) }) %>
                                <% } else if (p.due_date) { %><%= t('payments.dueOn', { date: formatDate(p.due_date) }) %><% if (overdue) { %> · <strong><%= t('payments.overdue') %></strong><% } %>
                                <% } else { %><%= t('payments.noDueDate') %><% } %>
                            </p>
                            <% if (p.note) { %><p class="item-notes"><%= p.note %></p><% } %>
                        </div>
                        <% if (canEdit) { %>
                            <form method="post" action="/payments/<%= p.id %>/paid" class="payment__toggle">
                                <%- include('partials/csrf-field') %>
                                <input type="hidden" name="paid" value="<%= p.paid_on ? '0' : '1' %>">
                                <button type="submit" class="btn btn-small <%= p.paid_on ? 'btn-ghost' : 'btn-secondary' %>"
                                        aria-label="<%= t(p.paid_on ? 'payments.markUnpaidNamed' : 'payments.markPaidNamed', { name, amount: formatCurrency(p.amount) }) %>">
                                    <%= t(p.paid_on ? 'payments.markUnpaid' : 'payments.markPaid') %>
                                </button>
                            </form>
                            <%- include('partials/row-actions', { editHref: `/payments/${p.id}/edit`, deleteAction: `/payments/${p.id}/delete`, name: `${name} ${formatCurrency(p.amount)}`, confirm: t('confirm.deletePayment', { name, amount: formatCurrency(p.amount) }) }) %>
                        <% } %>
                    </li>
                <% }); %>
            </ul>
        <% } %>
        <% if (money.unscheduled !== null && money.unscheduled > 0) { %>
            <p class="hint"><%= t('payments.unscheduled', { amount: formatCurrency(money.unscheduled) }) %></p>
        <% } else if (money.unscheduled !== null && money.unscheduled < 0) { %>
            <p class="hint"><%= t('payments.overScheduled', { amount: formatCurrency(-money.unscheduled) }) %></p>
        <% } %>

        <% if (canEdit) { %>
            <%- include('partials/add-panel-start', { id: 'add-payment', labelKey: 'payments.add', open: payments.length === 0 || paymentForm.errors.length > 0 }) %>
                <%- include('partials/form-errors', { errors: paymentForm.errors, id: 'payment-errors' }) %>
                <form method="post" action="/vendors/<%= vendor.id %>/payments" class="form-grid">
                    <%- include('partials/csrf-field') %>
                    <%- include('partials/payment-fields', { values: paymentForm.values, errors: paymentForm.errors, errorsId: 'payment-errors' }) %>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary"><%= t('payments.addSubmit') %></button>
                    </div>
                </form>
            <%- include('partials/add-panel-end') %>
        <% } %>
    </section>
</main>

<%- include('partials/footer') %>
