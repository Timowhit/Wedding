<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main-content">
    <header class="page-header"><h1><%= title %></h1></header>
    <section class="card">
        <%- include('partials/form-errors', { errors, id: 'questionnaire-errors' }) %>
        <form method="post" action="<%= id ? `/library/questionnaires/${id}/edit` : '/library/questionnaires' %>" class="form-stack" data-question-builder data-max-rows="<%= maxRows %>">
            <%- include('partials/csrf-field') %>
            <div class="field">
                <label for="q-title"><%= t('library.qTitle') %></label>
                <input type="text" id="q-title" name="title" required maxlength="120" value="<%= values.title %>" <%- fieldState(errors, 'title', 'questionnaire-errors') %>>
            </div>
            <div class="field">
                <label for="q-intro"><%= t('library.qIntro') %> <span class="optional"><%= t('form.optional') %></span></label>
                <textarea id="q-intro" name="intro" rows="3" maxlength="2000" <%- fieldState(errors, 'intro', 'questionnaire-errors') %>><%= values.intro %></textarea>
            </div>
            <%# Pressing Enter in a field clicks the form's first submit button: make that Save, not a question's −. %>
            <button type="submit" class="visually-hidden" tabindex="-1" aria-hidden="true"><%= t('library.saveQuestionnaire') %></button>
            <ol class="question-rows" data-legend="<%= t('library.questionN', { n: '{n}' }) %>"
                data-remove-label="<%= t('library.removeQuestionN', { n: '{n}' }) %>" data-add-label="<%= t('library.addQuestionUnderN', { n: '{n}' }) %>">
                <% values.rows.forEach((row, i) => { %>
                    <li class="question-row" data-question-row>
                        <fieldset>
                            <legend data-question-legend><%= t('library.questionN', { n: i + 1 }) %></legend>
                            <%# Without JavaScript these post the form and it comes back changed; with it they work in place. %>
                            <div class="step-pill" data-row-tools>
                                <button type="submit" name="row_action" value="remove:<%= i %>" class="step-pill__btn" data-remove-question
                                        aria-label="<%= t('library.removeQuestionN', { n: i + 1 }) %>" title="<%= t('library.removeQuestionN', { n: i + 1 }) %>"
                                        <%- values.rows.length <= 1 ? 'disabled' : '' %>><span aria-hidden="true">&minus;</span></button>
                                <button type="submit" name="row_action" value="add:<%= i %>" class="step-pill__btn" data-add-question
                                        aria-label="<%= t('library.addQuestionUnderN', { n: i + 1 }) %>" title="<%= t('library.addQuestionUnderN', { n: i + 1 }) %>"
                                        <%- values.rows.length >= maxRows ? 'disabled' : '' %>><span aria-hidden="true">+</span></button>
                            </div>
                            <div class="field">
                                <label for="q<%= i %>-text"><%= t('library.questionText') %></label>
                                <input type="text" id="q<%= i %>-text" name="q<%= i %>_text" maxlength="300" value="<%= row.text %>" <%- fieldState(errors, `q${i}_text`, 'questionnaire-errors') %><%- locals.focus === i ? ' autofocus' : '' %>>
                            </div>
                            <div class="field">
                                <label for="q<%= i %>-type"><%= t('library.questionType') %></label>
                                <select id="q<%= i %>-type" name="q<%= i %>_type">
                                    <%- include('partials/options', { options: types, selected: row.type, prefix: 'questionType' }) %>
                                </select>
                            </div>
                            <div class="field">
                                <label for="q<%= i %>-options"><%= t('library.questionOptions') %></label>
                                <textarea id="q<%= i %>-options" name="q<%= i %>_options" rows="3" <%- fieldState(errors, `q${i}_options`, 'questionnaire-errors', 'options-hint') %>><%= row.options %></textarea>
                            </div>
                        </fieldset>
                    </li>
                <% }); %>
            </ol>
            <p class="hint" id="options-hint"><%= t('library.builderHint') %></p>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><%= t('library.saveQuestionnaire') %></button>
                <a class="btn btn-ghost" href="/library"><%= t('action.cancel') %></a>
            </div>
        </form>
    </section>
</main>

<%- include('partials/footer') %>
