<%# Checklist progress for the active wedding, top right of the header. Expects taskBadge (may be null). %>
<% if (locals.taskBadge && taskBadge.total > 0) { %>
    <details class="task-badge">
        <summary class="task-badge__summary">
            <%# A ring drawn with SVG: the arc's dash length is the share done (pathLength="100"). %>
            <svg class="task-badge__ring" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
                <circle class="task-badge__track" cx="18" cy="18" r="15" pathLength="100"/>
                <circle class="task-badge__value" cx="18" cy="18" r="15" pathLength="100" stroke-dasharray="<%= taskBadge.pct %> 100"/>
            </svg>
            <span class="task-badge__pct" aria-hidden="true"><%= taskBadge.pct %>%</span>
            <span class="visually-hidden"><%= t('celebrate.badgeLabel', { done: taskBadge.done, total: taskBadge.total }) %></span>
        </summary>
        <div class="task-badge__panel">
            <p class="task-badge__count"><%= t('celebrate.badgeLabel', { done: taskBadge.done, total: taskBadge.total }) %></p>
            <% if (taskBadge.next.length > 0) { %>
                <p class="task-badge__next"><%= t('celebrate.nextUp') %></p>
                <ul class="task-badge__list">
                    <% taskBadge.next.forEach((task) => { %>
                        <li><%= task.text %><% if (task.due_date) { %> <span class="hint"><%= formatShortDate(task.due_date) %></span><% } %></li>
                    <% }); %>
                </ul>
            <% } else { %>
                <p><%= t('celebrate.allDone') %></p>
            <% } %>
            <a class="btn btn-secondary btn-small" href="/checklist"><%= t('celebrate.openChecklist') %></a>
        </div>
    </details>
<% } %>
