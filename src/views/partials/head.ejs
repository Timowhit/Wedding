<!DOCTYPE html>
<% const theme = currentTheme(); const asset = locals.asset || ((path) => path); %>
<html lang="<%= lang %>" data-palette="<%= theme.palette %>" data-mode="<%= locals.forceLightMode ? 'light' : theme.mode %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title><%= locals.title ? `${title} · Forever Planner` : 'Forever Planner' %></title>
    <link rel="icon" href="/images/logo.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="<%= asset('/css/main.css') %>">
    <link rel="stylesheet" href="<%= asset('/css/themes.css') %>">
    <% if (theme.colors) { %><link rel="stylesheet" href="/css/custom/<%= theme.colors %>.css" data-custom-theme><% } %>
    <script src="<%= asset('/js/app.js') %>" defer></script>
    <% (locals.scripts || []).forEach((src) => { %><script src="<%= asset(src) %>" defer></script><% }); %>
</head>
<body<% if (locals.bodyClass) { %> class="<%= bodyClass %>"<% } %><% if (locals.user) { %> data-offline<% } %><% if (locals.wedding) { %> data-wedding="<%= wedding.id %>"<% } %> data-rendered-at="<%= renderedAt %>">
    <a class="skip-link" href="#main-content"><%= t('nav.skip') %></a>
