<!DOCTYPE html>
<% const theme = currentTheme(); %>
<html lang="<%= lang %>" data-palette="<%= theme.palette %>" data-mode="<%= theme.mode %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title><%= locals.title ? `${title} · Forever Planner` : 'Forever Planner' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/themes.css">
    <script src="/js/app.js" defer></script>
</head>
<body<% if (locals.bodyClass) { %> class="<%= bodyClass %>"<% } %>>
    <a class="skip-link" href="#main-content"><%= t('nav.skip') %></a>
