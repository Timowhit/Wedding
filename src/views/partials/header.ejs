<%
    const isPlanner = Boolean(locals.user && user.isPlanner);
    const hasWedding = Boolean(locals.wedding);
    const navItems = [
        { href: '/planner', key: 'nav.allWeddings', hidden: !isPlanner },
        { href: '/', key: 'nav.dashboard', hidden: !hasWedding },
        { href: '/budget', key: 'nav.budget', hidden: !hasWedding },
        { href: '/guests', key: 'nav.guests', hidden: !hasWedding },
        { href: '/seating', key: 'nav.seating', hidden: !hasWedding },
        { href: '/layout', key: 'nav.layout', hidden: !hasWedding },
        { href: '/vendors', key: 'nav.vendors', hidden: !hasWedding },
        { href: '/checklist', key: 'nav.checklist', hidden: !hasWedding },
        { href: '/decisions', key: 'nav.decisions', hidden: !hasWedding },
        { href: '/schedule', key: 'nav.schedule', hidden: !hasWedding },
        { href: '/colors', key: 'nav.colors', hidden: !hasWedding },
        { href: '/music', key: 'nav.music', hidden: !hasWedding || !features.music },
        { href: '/inspiration', key: 'nav.inspiration', hidden: !hasWedding || !features.inspiration },
        { href: '/templates', key: 'nav.templates', hidden: !isPlanner },
        { href: '/settings', key: 'nav.settings' }
    ].filter((item) => !item.hidden || currentPath === item.href);
    const isCurrent = (href) => (href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`));
    const hasNav = Boolean(locals.user && (hasWedding || isPlanner));
%>
<header class="site-header">
    <div class="site-header__bar">
        <a class="brand" href="/"><%- include('logo') %><span class="brand__name">Forever <em>Planner</em></span></a>

        <% if (hasNav && hasWedding && weddings.length > 1) { %>
            <form class="wedding-switcher" method="post" action="/wedding/switch">
                <%- include('csrf-field') %>
                <input type="hidden" name="return_to" value="<%= currentUrl %>">
                <label class="visually-hidden" for="wedding-switcher"><%= t('nav.activeWedding') %></label>
                <select id="wedding-switcher" name="wedding_id" data-autosubmit>
                    <% weddings.forEach((w) => { %>
                        <option value="<%= w.id %>" <%= w.id === wedding.id ? 'selected' : '' %>><%= w.wedding_date ? `${w.name} · ${formatDate(w.wedding_date)}` : w.name %></option>
                    <% }); %>
                </select>
                <button type="submit" class="btn btn-ghost btn-small" data-hide-with-js><%= t('nav.switch') %></button>
            </form>
        <% } else if (hasNav && hasWedding) { %>
            <p class="wedding-current"><span class="visually-hidden"><%= t('nav.activeWedding') %>: </span><%= wedding.name %></p>
        <% } %>
        <% if (hasNav) { %>
            <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav" hidden>
                <span class="visually-hidden"><%= t('nav.menu') %></span>
                <span class="nav-toggle__bar" aria-hidden="true"></span>
            </button>
        <% } else if (!locals.user) { %>
            <div class="site-header__guest">
                <a class="btn btn-ghost btn-small" href="/login" <%- currentPath === '/login' ? 'aria-current="page"' : '' %>><%= t('auth.signIn') %></a>
                <a class="btn btn-primary btn-small" href="/start" <%- currentPath === '/register' ? 'aria-current="page"' : '' %>><%= t('auth.createAccount') %></a>
            </div>
        <% } %>
    </div>

    <% if (hasNav) { %>
        <nav id="site-nav" class="site-nav" aria-label="<%= t('nav.label') %>">
            <ul>
                <% navItems.forEach((item) => { %>
                    <li><a href="<%= item.href %>" <%- isCurrent(item.href) ? 'aria-current="page"' : '' %>><%= t(item.key) %></a></li>
                <% }); %>
            </ul>
            <%- include('account') %>
        </nav>
    <% } else if (locals.user) { %>
        <%- include('account') %>
    <% } %>
    <%- include('offline-banner') %>
</header>
