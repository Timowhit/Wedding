<%# The upload form. Expects form ({values, errors}), kinds, fileMaxMb; optional vendor (preset and hidden) and vendors (a picker). %>
<% const errorsId = 'upload-errors'; %>
<%- include('form-errors', { errors: form.errors, id: errorsId }) %>
<%# The CSRF token goes first: the server reads the fields in order (middleware/upload.js). %>
<form method="post" action="/files" enctype="multipart/form-data" class="form-grid upload-form">
    <%- include('csrf-field') %>
    <input type="hidden" name="return_to" value="<%= locals.vendor ? `/vendors/${vendor.id}` : currentUrl %>">
    <div class="field field--wide">
        <label for="upload-file"><%= t('files.file') %></label>
        <input type="file" id="upload-file" name="file" required
               accept=".pdf,.png,.jpg,.jpeg,.gif,.webp,.docx,.xlsx,.txt,application/pdf,image/png,image/jpeg,image/gif,image/webp"
               aria-describedby="upload-hint" <%- fieldState(form.errors, 'file', errorsId) %>>
        <p class="hint" id="upload-hint"><%= t('files.hint', { max: fileMaxMb }) %></p>
    </div>
    <div class="field">
        <label for="upload-kind"><%= t('files.kindLabel') %></label>
        <select id="upload-kind" name="kind" <%- fieldState(form.errors, 'kind', errorsId) %>>
            <%- include('options', { options: kinds, selected: form.values.kind, prefix: 'fileKind' }) %>
        </select>
    </div>
    <% if (locals.vendor) { %>
        <input type="hidden" name="vendor_id" value="<%= vendor.id %>">
    <% } else if (locals.vendors && vendors.length > 0) { %>
        <div class="field">
            <label for="upload-vendor"><%= t('files.vendor') %> <span class="optional"><%= t('form.optional') %></span></label>
            <select id="upload-vendor" name="vendor_id" <%- fieldState(form.errors, 'vendor_id', errorsId) %>>
                <option value=""><%= t('files.noVendor') %></option>
                <% vendors.forEach((v) => { %><option value="<%= v.id %>" <%= v.id === form.values.vendor_id ? 'selected' : '' %>><%= v.name %></option><% }); %>
            </select>
        </div>
    <% } %>
    <div class="field field--wide">
        <label for="upload-note"><%= t('files.note') %> <span class="optional"><%= t('form.optional') %></span></label>
        <input type="text" id="upload-note" name="note" maxlength="300" value="<%= form.values.note %>" <%- fieldState(form.errors, 'note', errorsId) %>>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= t('files.upload') %></button>
    </div>
</form>
