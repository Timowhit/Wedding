<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main-content">
    <%- include('partials/page-header', { heading: 'guests.heading', subtitle: 'guests.subtitle' }) %>
    <%- include('partials/flash') %>
    <%- include('partials/read-only-notice') %>

    <section aria-labelledby="guest-stats-heading">
        <h2 class="visually-hidden" id="guest-stats-heading"><%= t('guests.summary') %></h2>
        <ul class="stats-grid stats-grid--compact">
            <li class="stat-card"><span class="stat-value"><%= stats.total %></span><span class="stat-label"><%= t('guests.total') %></span></li>
            <li class="stat-card"><span class="stat-value"><%= stats.confirmed %></span><span class="stat-label"><%= t('rsvpPlural.Confirmed') %></span></li>
            <li class="stat-card"><span class="stat-value"><%= stats.pending %></span><span class="stat-label"><%= t('rsvpPlural.Pending') %></span></li>
            <li class="stat-card"><span class="stat-value"><%= stats.declined %></span><span class="stat-label"><%= t('rsvpPlural.Declined') %></span></li>
            <li class="stat-card"><span class="stat-value"><%= stats.plusOnes %></span><span class="stat-label"><%= t('guests.plusOnes') %></span></li>
        </ul>
    </section>

    <% if (canEdit) { %>
        <%- include('partials/add-panel-start', { id: 'add-guest', labelKey: 'guests.add', open: stats.total === 0 || guestForm.errors.length > 0 }) %>
            <%- include('partials/form-errors', { errors: guestForm.errors, id: 'guest-errors' }) %>
            <form method="post" action="/guests" class="form-grid">
                <%- include('partials/csrf-field') %>
                <%- include('partials/return-to') %>
                <%- include('partials/guest-fields', { values: guestForm.values, errors: guestForm.errors, errorsId: 'guest-errors' }) %>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><%= t('guests.addSubmit') %></button>
                </div>
            </form>
        <%- include('partials/add-panel-end') %>
    <% } %>

    <section aria-labelledby="guest-list-heading">
        <h2 class="section-heading" id="guest-list-heading"><%= t('guests.list') %></h2>
        <% if (mealSummary.meals.length > 0) { %>
            <p class="meal-summary"><strong><%= t('guests.mealsHeading') %></strong>
                <%= [...mealSummary.meals.map((m) => `${m.meal} ${m.count}`), ...(mealSummary.notChosen ? [t('guests.mealNotChosen', { count: mealSummary.notChosen })] : [])].join(' · ') %>
            </p>
        <% } %>
        <nav class="filter-tabs" aria-label="<%= t('filter.byRsvp') %>">
            <a class="filter-tab" href="/guests" <%- activeRsvp === null ? 'aria-current="page"' : '' %>><%= t('filter.all') %></a>
            <% statuses.forEach((status) => { %>
                <a class="filter-tab" href="/guests?rsvp=<%= status %>" <%- activeRsvp === status ? 'aria-current="page"' : '' %>><%= t(`rsvp.${status}`) %></a>
            <% }); %>
        </nav>

        <% if (guests.length === 0) { %>
            <p class="empty-state"><span aria-hidden="true">👥</span> <%= t(activeRsvp ? 'filter.noMatches' : 'guests.empty') %></p>
        <% } else { %>
            <ul class="item-list">
                <% guests.forEach((guest) => { %>
                    <li class="item-card">
                        <div class="item-info">
                            <p class="item-name"><%= guest.name %><% if (guest.group_name) { %> <span class="tag"><%= guest.group_name %></span><% } %></p>
                            <% if (guest.diet || guest.plus_one || guest.meal || guest.accessibility) { %>
                                <p class="item-meta">
                                    <% if (guest.meal) { %><span><%= t('guests.mealLabel', { meal: guest.meal }) %></span><% } %>
                                    <% if (guest.accessibility) { %><span class="access-note"><%= t('guests.accessibilityLabel', { needs: guest.accessibility }) %></span><% } %>
                                    <% if (guest.diet) { %><span><%= t('guests.dietLabel', { diet: guest.diet }) %></span><% } %>
                                    <% if (guest.plus_one) { %><span><%= t('guests.plusOneLabel', { name: guest.plus_one }) %></span><% } %>
                                </p>
                            <% } %>
                            <%- include('partials/custom-field-values', { fields: customFields, custom: guest.custom }) %>
                        </div>
                        <div class="item-side">
                            <%- include('partials/status-form', { action: `/guests/${guest.id}/rsvp`, field: 'rsvp', value: guest.rsvp, options: statuses, prefix: 'rsvp', label: t('guests.rsvpFor', { name: guest.name }), id: `rsvp-${guest.id}` }) %>
                        </div>
                        <% if (canEdit) { %>
                            <%- include('partials/row-actions', { editHref: `/guests/${guest.id}/edit`, deleteAction: `/guests/${guest.id}/delete`, name: guest.name, confirm: t('confirm.deleteGuest', { name: guest.name }) }) %>
                        <% } %>
                    </li>
                <% }); %>
            </ul>
        <% } %>
    </section>
</main>

<%- include('partials/footer') %>
