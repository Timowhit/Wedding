<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main-content">
    <%- include('partials/page-header', { heading: 'vendors.heading', subtitle: 'vendors.subtitle' }) %>
    <%- include('partials/flash') %>
    <%- include('partials/read-only-notice') %>

    <% if (canEdit) { %>
        <%- include('partials/add-panel-start', { id: 'add-vendor', labelKey: 'vendors.add', open: (vendors.length === 0 && activeStatus === null) || vendorForm.errors.length > 0 }) %>
            <%- include('partials/form-errors', { errors: vendorForm.errors, id: 'vendor-errors' }) %>
            <form method="post" action="/vendors" class="form-grid">
                <%- include('partials/csrf-field') %>
                <%- include('partials/return-to') %>
                <%- include('partials/vendor-fields', { values: vendorForm.values, errors: vendorForm.errors, errorsId: 'vendor-errors' }) %>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><%= t('vendors.addSubmit') %></button>
                </div>
            </form>
        <%- include('partials/add-panel-end') %>
    <% } %>

    <section aria-labelledby="vendor-list-heading">
        <h2 class="section-heading" id="vendor-list-heading"><%= t('vendors.list') %></h2>
        <nav class="filter-tabs" aria-label="<%= t('filter.byStatus') %>">
            <a class="filter-tab" href="/vendors" <%- activeStatus === null ? 'aria-current="page"' : '' %>><%= t('filter.all') %></a>
            <% statuses.forEach((status) => { %>
                <a class="filter-tab" href="/vendors?status=<%= status %>" <%- activeStatus === status ? 'aria-current="page"' : '' %>><%= t(`vendorStatus.${status}`) %></a>
            <% }); %>
        </nav>

        <% if (vendors.length === 0) { %>
            <p class="empty-state"><span aria-hidden="true">🤝</span> <%= t(activeStatus ? 'filter.noMatches' : 'vendors.empty') %></p>
        <% } else { %>
            <ul class="item-list">
                <% vendors.forEach((vendor) => { %>
                    <li class="item-card">
                        <div class="item-info">
                            <p class="item-name"><a class="item-link" href="/vendors/<%= vendor.id %>"><%= vendor.name %></a> <span class="tag"><%= t(`vendorCategory.${vendor.category}`) %></span><% if (vendor.rating) { %> <span class="stars stars--small"><span class="visually-hidden"><%= t('wrapup.rated', { rating: vendor.rating, max: ratingMax }) %></span><span aria-hidden="true"><%= '★'.repeat(vendor.rating) + '☆'.repeat(ratingMax - vendor.rating) %></span></span><% } %></p>
                            <%# Rows saved by older versions were validated less strictly: only http(s) becomes a link. %>
                            <% const website = vendor.website && /^https?:\/\//i.test(vendor.website) ? vendor.website : null; %>
                            <% if (vendor.phone || vendor.email || website) { %>
                                <ul class="contact-list">
                                    <% if (vendor.phone) { %><li><a href="tel:<%= vendor.phone.replace(/[^\d+]/g, '') %>"><%= vendor.phone %></a></li><% } %>
                                    <% if (vendor.email) { %><li><a href="mailto:<%= vendor.email %>"><%= vendor.email %></a></li><% } %>
                                    <% if (website) { %><li><a href="<%= website %>" rel="noopener noreferrer" target="_blank"><%= t('vendors.visitWebsite') %><span class="visually-hidden"> (<%= t('action.opensNewTab') %>)</span></a></li><% } %>
                                </ul>
                            <% } %>
                            <% const m = money.get(vendor.id); %>
                            <% if (m && m.counts && m.committed > 0) { %>
                                <p class="item-meta money-line <%= m.overdue ? 'text-danger' : '' %>">
                                    <%= t('vendor.contractLine', { total: formatCurrency(m.committed), owed: formatCurrency(m.owed) }) %><% if (m.nextDue) { %> · <%= t('vendor.nextDue', { date: formatDate(m.nextDue) }) %><% } %><% if (m.overdue) { %> · <strong><%= t('payments.overdue') %></strong><% } %>
                                </p>
                            <% } else if (m && m.quote !== null) { %>
                                <p class="item-meta money-line"><%= t('vendor.quoteLine', { amount: formatCurrency(m.quote) }) %></p>
                            <% } %>
                            <% if (vendor.notes) { %><p class="item-notes"><%= vendor.notes %></p><% } %>
                        </div>
                        <div class="item-side">
                            <%- include('partials/status-form', { action: `/vendors/${vendor.id}/status`, field: 'status', value: vendor.status, options: statuses, prefix: 'vendorStatus', label: t('vendors.statusFor', { name: vendor.name }), id: `status-${vendor.id}` }) %>
                        </div>
                        <% if (canEdit) { %>
                            <%- include('partials/row-actions', { editHref: `/vendors/${vendor.id}/edit`, deleteAction: `/vendors/${vendor.id}/delete`, name: vendor.name, confirm: paymentCounts.get(vendor.id) ? t('confirm.deleteVendorWithPayments', { name: vendor.name, count: paymentCounts.get(vendor.id) }) : t('confirm.deleteVendor', { name: vendor.name }) }) %>
                        <% } %>
                    </li>
                <% }); %>
            </ul>
        <% } %>
    </section>
</main>

<%- include('partials/footer') %>
