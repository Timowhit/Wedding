<%
    const filterUrl = (changes) => {
        const params = new URLSearchParams();
        const next = { ...filters, ...changes };
        if (next.status) params.set('status', next.status);
        if (next.category) params.set('category', next.category);
        const query = params.toString();
        return query ? `/checklist?${query}` : '/checklist';
    };
%>
<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main-content">
    <%- include('partials/page-header', { heading: 'checklist.heading', subtitle: 'checklist.subtitle' }) %>
    <%- include('partials/flash') %>
    <%- include('partials/read-only-notice') %>

    <section class="card" aria-labelledby="progress-heading">
        <h2 class="visually-hidden" id="progress-heading"><%= t('checklist.progress') %></h2>
        <label class="progress-label" for="task-progress"><%= t('checklist.progressLabel', { done: progress.done, total: progress.total }) %></label>
        <progress id="task-progress" class="progress" max="100" value="<%= progress.pct %>"><%= progress.pct %>%</progress>
        <% if (canEdit && progress.total === 0) { %>
            <form method="post" action="/checklist/examples" class="card-footer-action">
                <%- include('partials/csrf-field') %>
                <button type="submit" class="btn btn-secondary"><%= t('checklist.loadExamples') %></button>
            </form>
        <% } %>
    </section>

    <% if (canEdit) { %>
        <%- include('partials/add-panel-start', { id: 'add-task', labelKey: 'checklist.add', open: progress.total === 0 || taskForm.errors.length > 0 }) %>
            <%- include('partials/form-errors', { errors: taskForm.errors, id: 'task-errors' }) %>
            <form method="post" action="/checklist" class="form-grid">
                <%- include('partials/csrf-field') %>
                <%- include('partials/return-to') %>
                <%- include('partials/task-fields', { values: taskForm.values, errors: taskForm.errors, errorsId: 'task-errors' }) %>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><%= t('checklist.addSubmit') %></button>
                </div>
            </form>
        <%- include('partials/add-panel-end') %>
        <%- include('partials/template-tools', { kind: 'checklist', action: '/checklist', templates, templateForm }) %>
    <% } %>

    <section aria-labelledby="task-list-heading">
        <h2 class="section-heading" id="task-list-heading"><%= t('checklist.tasks') %></h2>
        <div class="filter-bar">
            <nav class="filter-tabs" aria-label="<%= t('filter.byStatus') %>">
                <a class="filter-tab" href="<%= filterUrl({ status: null }) %>" <%- filters.status === null ? 'aria-current="page"' : '' %>><%= t('filter.all') %></a>
                <a class="filter-tab" href="<%= filterUrl({ status: 'active' }) %>" <%- filters.status === 'active' ? 'aria-current="page"' : '' %>><%= t('checklist.statusActive') %></a>
                <a class="filter-tab" href="<%= filterUrl({ status: 'done' }) %>" <%- filters.status === 'done' ? 'aria-current="page"' : '' %>><%= t('checklist.statusDone') %></a>
            </nav>
            <form method="get" action="/checklist" class="filter-select">
                <% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %>
                <label for="category-filter"><%= t('field.category') %></label>
                <select id="category-filter" name="category" data-autosubmit>
                    <option value=""><%= t('filter.allCategories') %></option>
                    <%- include('partials/options', { options: categories, selected: filters.category, prefix: 'taskCategory' }) %>
                </select>
                <button type="submit" class="btn btn-ghost btn-small" data-hide-with-js><%= t('filter.apply') %></button>
            </form>
        </div>

        <% if (tasks.length === 0) { %>
            <p class="empty-state"><span aria-hidden="true">📋</span> <%= t(filters.status || filters.category ? 'filter.noMatches' : 'checklist.empty') %></p>
        <% } else { %>
            <ul class="item-list">
                <% tasks.forEach((task) => { %>
                    <% const due = toIsoDate(task.due_date); const overdue = !task.done && due && due < today; %>
                    <li class="item-card item-card--task <%= task.done ? 'item-card--done' : '' %>">
                        <% if (canEdit) { %>
                            <form method="post" action="/checklist/<%= task.id %>/toggle" class="check-form">
                                <%- include('partials/csrf-field') %>
                                <%- include('partials/return-to') %>
                                <button type="submit" class="check-btn" aria-pressed="<%= task.done %>"
                                        aria-label="<%= t(task.done ? 'checklist.markActive' : 'checklist.markDone', { name: task.text }) %>"><span class="check-btn__circle" aria-hidden="true"><%= task.done ? '✓' : '' %></span></button>
                            </form>
                        <% } else { %>
                            <span class="check-btn check-btn--static" aria-hidden="true"><span class="check-btn__circle"><%= task.done ? '✓' : '' %></span></span>
                        <% } %>
                        <div class="item-info">
                            <p class="item-name"><%= task.text %><% if (task.done) { %><span class="visually-hidden"> (<%= t('checklist.statusDone') %>)</span><% } %></p>
                            <p class="item-meta">
                                <span class="tag"><%= t(`taskCategory.${task.category}`) %></span>
                                <% if (due) { %><span class="<%= overdue ? 'text-danger' : '' %>"><%= t(overdue ? 'checklist.overdue' : 'checklist.due', { date: formatDate(task.due_date) }) %></span><% } %>
                            </p>
                            <% if (canEdit) { %>
                                <%- include('partials/row-actions', { editHref: `/checklist/${task.id}/edit`, deleteAction: `/checklist/${task.id}/delete`, name: task.text, confirm: t('confirm.deleteTask', { name: task.text }) }) %>
                            <% } %>
                        </div>
                    </li>
                <% }); %>
            </ul>
        <% } %>
    </section>
</main>

<%- include('partials/footer') %>
